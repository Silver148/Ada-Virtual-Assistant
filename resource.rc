MAINICON ICON "Ada-ICON.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,6,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0
#endif
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName",      "Juan Yaguaro(aka silverhacker)"
			VALUE "FileDescription",  "Ada Virtual Assistant"
			VALUE "FileVersion",      "1.0.0.0"
			VALUE "InternalName",     "Ada"
			VALUE "LegalCopyright",   "Copyright (c) 2026 Juan Yaguaro. All rights reserved."
			VALUE "OriginalFilename", "Ada.exe"
			VALUE "ProductName",      "Ada"
			VALUE "ProductVersion",   "1.6.1.0"
			VALUE "Comments",         "Open Source - MIT License."
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 0x04B0
	END
END