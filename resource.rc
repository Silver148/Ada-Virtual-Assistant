			VALUE "CompanyName", "Juan Yaguaro (aka silverhacker)"
			VALUE "FileDescription", "Ada Virtual Assistant"
			VALUE "FileVersion", "1.7.3.0"
			VALUE "InternalName", "Ada"
			VALUE "LegalCopyright", "Copyright (c) 2026 Juan Yaguaro (aka silverhacker)"
			VALUE "LegalTrademarks",  "MIT License - Open Source Software"
			VALUE "OriginalFilename", "Ada.exe"
			VALUE "ProductName", "Ada"
			VALUE "ProductVersion", "1.7.3.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 0x04B0
	END
END